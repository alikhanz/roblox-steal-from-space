--!strict

local BigNum = require("../../src/shared/Domain/BigNum")
local FriendBonus = require("../../src/shared/Domain/FriendBonus")
local FriendConfig = require("../../src/shared/Config/FriendConfig")
local Test = require("../../lune/lib/Test")
local describe, it, expect = Test.describe, Test.it, Test.expect

local function near(value: BigNum.BigNum, expected: number)
	expect(math.abs(BigNum.toNumber(value) - expected) < 1e-9 * math.max(1, expected)).toBe(true)
end

describe("FriendBonus.percentOf", function()
	it("adds 10 % for each friend, up to three", function()
		expect(FriendBonus.percentOf(0)).toBe(0)
		expect(FriendBonus.percentOf(1)).toBe(10)
		expect(FriendBonus.percentOf(2)).toBe(20)
		expect(FriendBonus.percentOf(3)).toBe(30)
	end)

	it("stops at +30 % however many friends play", function()
		expect(FriendBonus.percentOf(4)).toBe(30)
		expect(FriendBonus.percentOf(7)).toBe(30)
		expect(FriendBonus.maxPercent()).toBe(FriendConfig.MAX_FRIENDS * FriendConfig.PERCENT_PER_FRIEND)
	end)

	it("refuses a count that is not a whole number of players", function()
		expect(function()
			FriendBonus.percentOf(-1)
		end).toThrow()
		expect(function()
			FriendBonus.percentOf(1.5)
		end).toThrow()
	end)
end)

describe("FriendBonus.extra and boosted", function()
	it("adds nothing without friends", function()
		local coins = BigNum.fromNumber(250)
		expect(BigNum.isZero(FriendBonus.extra(coins, 0))).toBe(true)
		near(FriendBonus.boosted(coins, 0), 250)
	end)

	it("scales the coins by the bonus", function()
		local coins = BigNum.fromNumber(250)
		near(FriendBonus.extra(coins, 1), 25)
		near(FriendBonus.boosted(coins, 2), 300)
		near(FriendBonus.boosted(coins, 5), 325)
	end)

	it("works on incomes far past double range", function()
		local coins = BigNum.mul(BigNum.fromNumber(1e300), BigNum.fromNumber(1e300))
		local boosted = FriendBonus.boosted(coins, 3)
		local ratio = BigNum.toNumber(BigNum.div(boosted, coins))
		expect(math.abs(ratio - 1.3) < 1e-9).toBe(true)
	end)
end)

describe("FriendBonus circle", function()
	it("counts friends on both sides of a link", function()
		local circle = FriendBonus.newCircle()
		circle.link(1, 2)
		circle.link(1, 3)
		expect(circle.countOf(1)).toBe(2)
		expect(circle.countOf(2)).toBe(1)
		expect(circle.countOf(3)).toBe(1)
		expect(circle.countOf(4)).toBe(0)
	end)

	it("counts a pair once, however many times it is linked", function()
		-- Two players joining together both ask Roblox about each other.
		local circle = FriendBonus.newCircle()
		circle.link(1, 2)
		circle.link(2, 1)
		expect(circle.countOf(1)).toBe(1)
		expect(circle.countOf(2)).toBe(1)
	end)

	it("forgets a player who left, for everyone, and names whom it touched", function()
		local circle = FriendBonus.newCircle()
		circle.link(1, 2)
		circle.link(1, 3)
		circle.link(2, 3)
		local touched = circle.forget(1)
		expect(#touched).toBe(2)
		expect(touched[1]).toBe(2)
		expect(touched[2]).toBe(3)
		expect(circle.countOf(1)).toBe(0)
		expect(circle.countOf(2)).toBe(1)
		expect(circle.countOf(3)).toBe(1)
		expect(#circle.forget(1)).toBe(0)
	end)

	it("lists a player's friends", function()
		local circle = FriendBonus.newCircle()
		circle.link(5, 9)
		circle.link(5, 7)
		local friends = circle.friendsOf(5)
		expect(#friends).toBe(2)
		expect(friends[1]).toBe(7)
		expect(friends[2]).toBe(9)
	end)

	it("is nobody's own friend", function()
		local circle = FriendBonus.newCircle()
		expect(function()
			circle.link(4, 4)
		end).toThrow()
	end)
end)
